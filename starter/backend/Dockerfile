FROM python:3.10-slim
ENV FLASK_RUN_HOST=0.0.0.0

WORKDIR /app

RUN adduser --uid 1000 --disabled-password --gecos "" app

# Install build tools needed to compile uwsgi C extension on Debian Slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpcre3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies via pip from pre-generated requirements.txt
# (generated by `pipenv requirements` in the CI build job)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 5000

CMD ["uwsgi", "--http", ":5000", "--master", "--enable-threads", \
     "-s", "/var/www/app/app.sock", "--manage-script-name", \
     "--mount", "/=app:app"]